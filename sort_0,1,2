void sort012(int arr[], int n) {
    int c1 = 0;
    int c2 = 0;
    int c3 = 0;
    for(int i = 0 ;i<n;i++){
        if(arr[i]==0){
            c1++;
        }
        else if(arr[i]==1){
            c2++;
        }
        else{
            c3++;
        }
    }
    for(int i = 0 ; i<c1;i++){
        arr[i]=0;
    }
    for(int i=c1;i<c2+c1;i++){
        arr[i]=1;
    }
    for(int i=c2+c1;i<n;i++){
        arr[i]=2;
    }

}
  
