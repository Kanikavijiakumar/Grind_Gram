int floorSqrt(int n) {
    int low = 1;
    int high = n/2 + 1;
    int mid;
    int ans;
    
    if (n==0 || n==1){
        return n;
    }
    while(low<=high){
        mid = (low+high)/2;
        if(mid*mid == n){
            return mid;
        }
        else if(mid*mid < n){
            low = mid+1;
            ans=mid;
        }
        else{
            high = mid -1;
        }
        
    }
    return ans;
}
